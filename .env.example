# ── Cơ sở dữ liệu ──
# Khi chạy bằng docker-compose, DATABASE_URL được dựng tự động từ POSTGRES_*.
# Khi phát triển trên máy (npm run db:local): postgresql://postgres:devonly_local_pw@localhost:54329/homthu
DATABASE_URL=postgresql://postgres:devonly_local_pw@localhost:54329/homthu
POSTGRES_USER=homthu
POSTGRES_PASSWORD=
POSTGRES_DB=homthu

# ── Bảo mật ──
# Khóa 32 byte (base64) dùng mã hóa thông tin người gửi và khóa TOTP.
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MẤT KHÓA NÀY = KHÔNG GIẢI MÃ ĐƯỢC thông tin người gửi đã lưu. Sao lưu riêng, tách khỏi bản sao lưu CSDL.
APP_ENCRYPTION_KEY=

# Thời gian phiên đăng nhập
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# Đặt true khi chạy sau reverse proxy (nginx) để lấy đúng địa chỉ cho giới hạn tần suất.
TRUST_PROXY=false
# Cookie chỉ gửi qua HTTPS. Đặt false CHỈ khi thử nghiệm trên máy cá nhân bằng http://localhost
COOKIE_SECURE=false

# ── Địa chỉ truy cập ──
# Địa chỉ chính thức mà mã QR trỏ tới (có thể đổi lại trong trang quản trị > Mã QR).
PUBLIC_BASE_URL=http://localhost:3000

# ── Triển khai bằng docker-compose ──
# Tên miền/địa chỉ nội bộ của máy chủ, dùng cho nginx.
SERVER_NAME=gopy.local
