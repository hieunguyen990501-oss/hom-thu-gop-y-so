{
  "name": "hom-thu-gop-y-so",
  "version": "1.0.0",
  "private": true,
  "description": "Hòm thư góp ý số - Lữ đoàn Pháo binh 572, Quân khu 5",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts --demo && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-demo": "tsx prisma/seed.ts --demo",
    "create-admin": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backup": "node scripts/test-backup-restore.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@hookform/resolvers": "5.2.2",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "exceljs": "4.4.0",
    "lucide-react": "0.544.0",
    "next": "15.5.28",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "7.63.0",
    "recharts": "3.2.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "embedded-postgres": "17.6.0-beta.15",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "@types/pngjs": "6.0.5",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/windows-x64@17.6.0-beta.15": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  }
}
