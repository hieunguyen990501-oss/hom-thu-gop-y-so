# Reverse proxy HTTPS cho Hòm thư góp ý số.
# Nhật ký truy cập KHÔNG ghi địa chỉ IP với các đường dẫn của cổng góp ý công khai (giảm dữ liệu định danh).

log_format no_ip '[$time_local] "$request_method $uri" $status $body_bytes_sent';
log_format staff '$remote_addr [$time_local] "$request_method $uri" $status';

map $uri $is_admin_path {
    default 0;
    ~^/(quan-tri|dang-nhap|doi-mat-khau|api/(qr|bao-cao|gop-y|thong-bao)) 1;
}
map $is_admin_path $is_public_path {
    0 1;
    default 0;
}

server {
    listen 80;
    server_name ${SERVER_NAME};
    access_log off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;
    client_max_body_size 256k;

    # Cổng công khai: không ghi IP. Khu quản trị: ghi IP để kiểm toán thao tác của cán bộ.
    access_log /var/log/nginx/public.log no_ip if=$is_public_path;
    access_log /var/log/nginx/admin.log staff if=$is_admin_path;

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        # Chỉ chuyển IP cho ứng dụng để giới hạn tần suất trong bộ nhớ; ứng dụng không lưu IP người gửi.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
